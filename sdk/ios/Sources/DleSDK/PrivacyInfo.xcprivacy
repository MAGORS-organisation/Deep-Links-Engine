<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple privacy manifest of the DLE iOS SDK (spec §E.7 item 4).

  Every entry below describes what the SDK actually does; nothing is declared "just in case",
  because an SDK's declarations are aggregated into every host app's privacy report.

  - NSPrivacyTracking is false: the SDK reads no advertising identifier, never links data
    across apps or companies, and never calls App Tracking Transparency.
  - NSPrivacyTrackingDomains is empty for the same reason.
  - NSPrivacyAccessedAPITypes is empty: the SDK stores its state in plain files under
    Application Support (no UserDefaults, category CA92.1 not needed) and never reads a file
    modification date (category C617.1 not needed). The Keychain and
    ProcessInfo.operatingSystemVersion are not required-reason APIs.
  - Collected data is what the two endpoints receive, and nothing else:
      * Device ID: a random installation UUID generated by the SDK, kept in the Keychain,
        never derived from the device and never the advertising identifier. Not linked to the
        user's identity, not used for tracking.
      * Product Interaction: the events of POST /v1/events (link_open, first_open, session,
        conversion, custom) with the timestamps and properties the host app supplies.
      * Other Usage Data: the four coarse device signals of POST /v1/resolve (UI language,
        screen size, UTC offset, hardware model). Sent only when the host app enabled the
        probabilistic strategy AND the user granted attribution consent; otherwise the SDK
        omits them entirely.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUsageData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
