<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Deep Link Engine (DLE) — package source policy.

    nuget.org is the only permitted feed. <clear /> removes any machine- or
    user-level source so a build behaves identically on a developer machine
    and in CI.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Every package must come from nuget.org; nothing may be silently substituted. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>

  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>

</configuration>
