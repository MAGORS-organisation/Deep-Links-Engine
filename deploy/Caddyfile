# =============================================================================
# Deep Link Engine (DLE) — Caddy front door for Profile A (docs/zadanie.md §B.8).
#
# Environment (set by docker-compose.yml from .env):
#   DLE_DOMAIN  public host name of the links, e.g. go.example.com
#   DLE_TLS     `internal` (Caddy's local CA, development) or an e-mail address (ACME: public
#               certificates from Let's Encrypt / ZeroSSL, renewed automatically)
#
# Routing (single host):
#   /.well-known/jwks.json                       → dle-control  (public signing keys, §B.7)
#   /.well-known/*                               → dle-edge     (AASA, assetlinks.json)
#   /api/*  /v1/*  /admin*  /scalar*  /openapi/* → dle-control  (API, admin console, API reference)
#   everything else, i.e. /{slug}, /{slug}/qr    → dle-edge
#
# !!! /.well-known RESPONSES MUST NEVER BE REDIRECTED (docs/zadanie.md §A.2.1, TC-124) !!!
# Apple's CDN and Google's verifier refuse an apple-app-site-association / assetlinks.json that
# answers with any 3xx — HTTP→HTTPS, trailing slash, www canonicalisation, all of them. Therefore:
#   - `auto_https disable_redirects` switches off Caddy's automatic HTTP→HTTPS redirect for the
#     whole server, and the http:// block below redirects everything EXCEPT /.well-known/* by hand;
#   - no `redir` or `uri` rewrite may ever be added in front of the well-known handlers;
#   - reverse_proxy adds no trailing-slash canonicalisation (only file_server would), so none is
#     needed and none must be introduced.
# Verify after every change:
#   curl -sI http://$DLE_DOMAIN/.well-known/apple-app-site-association  | head -1   → HTTP/1.1 200
#   curl -sI https://$DLE_DOMAIN/.well-known/apple-app-site-association | head -1   → HTTP/2 200
# =============================================================================

{
	# See the warning above — Caddy would otherwise redirect http://…/.well-known/* to https.
	auto_https disable_redirects

	servers {
		# HTTP/1.1, HTTP/2 and HTTP/3 (QUIC over UDP 443 — published in docker-compose.yml).
		protocols h1 h2 h3
	}

	# Post-quantum key exchange (docs/zadanie.md §E.5.3 Phase 0, K1):
	# Caddy ≥ 2.10, built with Go ≥ 1.24, negotiates the hybrid X25519MLKEM768 group in TLS 1.3 BY
	# DEFAULT — no directive is needed and the `caddy:2` image is such a build. Do NOT add a
	# `curves` line to a `tls` block unless it lists x25519mlkem768 first: an explicit list
	# replaces the default and would switch the hybrid off. Verify with an OpenSSL 3.5+ client:
	#   openssl s_client -connect $DLE_DOMAIN:443 -groups X25519MLKEM768 </dev/null 2>&1 | grep -i "server temp key\|negotiated"
	# Caddy < 2.10 (Go < 1.24) has no ML-KEM at all and silently falls back to X25519.

	admin localhost:2019
}

# ---- snippets ----------------------------------------------------------------------------------

(security_headers) {
	# `?` sets a header only when the upstream did not already set one: the edge emits its own
	# HSTS and CSP (Dle:Edge:Security) and those win. `-` removes a header.
	header {
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
		-X-Powered-By
	}
}

(to_edge) {
	reverse_proxy {
		# All replicas of the compose service `dle-edge`: Docker's DNS answers with every replica
		# address and Caddy re-resolves the name so scaling needs no reload.
		dynamic a {
			name dle-edge
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 2s
		health_uri /healthz
		health_interval 10s
		health_timeout 2s
		# Caddy sets X-Forwarded-For / -Proto / -Host; the edge honours them only from this
		# network (Dle:Edge:Network:KnownNetworks in docker-compose.yml).
	}
}

(to_control) {
	reverse_proxy dle-control:8081 {
		health_uri /healthz
		health_interval 10s
		health_timeout 2s
	}
}

(well_known_routes) {
	# `handle` blocks are mutually exclusive and the more specific path wins, so jwks.json
	# reaches the control plane and every other well-known file the edge.
	handle /.well-known/jwks.json {
		import to_control
	}
	handle /.well-known/* {
		import to_edge
	}
}

(dle_routes) {
	import well_known_routes

	@control path /api/* /v1/* /admin /admin/* /scalar /scalar/* /openapi/*
	handle @control {
		import to_control
	}

	# /{slug}, /{slug}/qr, the interstitial, and the root.
	handle {
		import to_edge
	}
}

# ---- sites -------------------------------------------------------------------------------------

# HTTPS. `tls internal` = local CA; `tls admin@example.com` = ACME with that account e-mail.
{$DLE_DOMAIN} {
	tls {$DLE_TLS}

	encode zstd gzip
	import security_headers
	import dle_routes

	log {
		output stdout
		format json
	}
}

# Plain HTTP. The well-known files are served straight through (never redirected — see the top
# of this file); everything else goes to HTTPS with a 308 so that method and body survive.
http://{$DLE_DOMAIN} {
	import well_known_routes

	handle {
		redir https://{host}{uri} 308
	}

	log {
		output stdout
		format json
	}
}

# ---- optional: a separate host name for the control plane ---------------------------------------
# Many deployments keep the admin console and API off the link domain. Uncomment, set the name,
# and remove `/admin*`, `/scalar*`, `/openapi/*` from @control above if the link host should not
# expose them at all. /.well-known/jwks.json stays reachable on both hosts.
#
# admin.example.com {
# 	tls {$DLE_TLS}
# 	encode zstd gzip
# 	import security_headers
# 	import to_control
# }
