# =============================================================================
# Deep Link Engine (DLE) — docker compose configuration for Profile A
# (docs/zadanie.md §B.8: caddy → dle-edge ×2 + dle-control ×1 → postgres:18 + valkey:8).
#
#   cp .env.example .env      # docker compose reads ./.env automatically
#
# Every variable is read by deploy/docker-compose.yml (and by the Caddyfile through the caddy
# service's environment). Values marked REQUIRED have no default: compose refuses to start until
# they are set. Everything else can stay as it is for a first run.
#
# How the values reach the applications: ASP.NET Core maps an environment variable
#   Dle__Edge__Cache__L1Seconds   →  configuration key  Dle:Edge:Cache:L1Seconds
# (double underscore = section separator). The full inventory of tunable keys, with defaults and
# comments, is src/Dle.Edge/appsettings.json and src/Dle.Control/appsettings.json. Anything not
# listed here can be added to the `environment:` block of the service in docker-compose.yml.
# =============================================================================


# -----------------------------------------------------------------------------
# Public endpoint (Caddy)
# -----------------------------------------------------------------------------

# REQUIRED. The public host name your links live on, e.g. go.example.com. Caddy obtains a
# certificate for it and Apple/Google fetch https://<DLE_DOMAIN>/.well-known/* from it.
# For a local run use `localhost` together with DLE_TLS=internal.
DLE_DOMAIN=go.example.com

# TLS issuer for Caddy's `tls` directive. Either
#   - an e-mail address → automatic public certificates (Let's Encrypt / ZeroSSL, ACME), or
#   - the word `internal` → Caddy's own local CA (development only; browsers warn).
DLE_TLS=admin@example.com

# Host ports Caddy publishes. 443 is used for TCP (HTTP/1.1, HTTP/2) and UDP (HTTP/3).
DLE_HTTP_PORT=80
DLE_HTTPS_PORT=443


# -----------------------------------------------------------------------------
# Secrets — REQUIRED
# -----------------------------------------------------------------------------

# REQUIRED. Password of the PostgreSQL role the services connect with. Used by postgres to
# create the role on first start and by every service to connect. Change it BEFORE the first
# `docker compose up`; postgres only reads it while initialising an empty data directory.
POSTGRES_PASSWORD=

# REQUIRED. Dle:Crypto:MasterSecret — at least 32 characters. Every keyed primitive in DLE
# (slug permutation, IP hashing salt, webhook bootstrap key, signing key wrapping) derives
# from it. Generate with:  openssl rand -base64 48
# Changing it later changes the slug permutation: back it up together with the database.
DLE_MASTER_SECRET=

# There is NO initial API key seed in the control plane (checked against
# src/Dle.Control/appsettings.json: Dle:Identity has no bootstrap key). Every request must
# carry an API key or an OIDC bearer token; tenants and keys are created through the API by a
# caller who is the instance operator. See "First credential" in deploy/README.md.


# -----------------------------------------------------------------------------
# Images
# -----------------------------------------------------------------------------

# Tag used for both DLE images when DLE_EDGE_IMAGE / DLE_CONTROL_IMAGE are not set explicitly.
DLE_VERSION=latest

# Full image references. Leave empty to use ghcr.io/magors-organisation/dle-{edge,control}:DLE_VERSION.
# `docker compose build` builds them locally from ../src with deploy/docker/Dockerfile.*.
DLE_EDGE_IMAGE=
DLE_CONTROL_IMAGE=

# PostgreSQL 18 is recommended, 16 is the minimum. The official image has citext but NOT
# pg_partman; the schema migration degrades gracefully (see deploy/postgres/init/01-extensions.sql).
# Build deploy/docker/Dockerfile.postgres for a postgres:18 with pg_partman and point this at it.
POSTGRES_IMAGE=postgres:18

VALKEY_IMAGE=valkey/valkey:8
CADDY_IMAGE=caddy:2


# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_DB=dle
POSTGRES_USER=dle

# Npgsql pool size PER EDGE REPLICA (Dle:Persistence:Fast:MaxPoolSize, default 64). Two replicas at
# 32 plus the control plane stay well under max_connections=200 in postgresql.tuning.conf.
DLE_EDGE_DB_POOL=32


# -----------------------------------------------------------------------------
# Valkey (shared L2 cache; cache only, nothing persisted)
# -----------------------------------------------------------------------------

VALKEY_MAXMEMORY=256mb


# -----------------------------------------------------------------------------
# Edge (data plane)
# -----------------------------------------------------------------------------

# Number of dle-edge containers. Profile A is two. Caddy balances over all of them by DNS.
DLE_EDGE_REPLICAS=2

# The compose network subnet. Caddy lives in it, so it is the only network whose X-Forwarded-*
# headers the edge honours (Dle:Edge:Network:KnownNetworks). The client address is the rate limit
# key, the click stream identifier and the GeoIP key — never trust a wider range than necessary.
DLE_NETWORK_SUBNET=172.28.0.0/24

# Host directory mounted read-only at /geoip inside dle-edge, and the file inside it
# (Dle:Edge:GeoIp:Path). Empty path = no GeoIP: country stays null, geo rules fall through to
# the default rule. The file is never downloaded by the edge (NFR-14); put it there yourself.
DLE_GEOIP_DIR=./geoip
DLE_GEOIP_PATH=
# e.g. DLE_GEOIP_PATH=/geoip/GeoLite2-Country.mmdb

# Interstitial branding (Dle:Edge:Interstitial). Optional.
DLE_PRODUCT_NAME=
DLE_SUPPORT_URL=
DLE_PRIVACY_URL=


# -----------------------------------------------------------------------------
# Control plane
# -----------------------------------------------------------------------------

# Dle:Control:InstanceTenantId — the tenant whose owners operate this instance (multi-tenant
# deployments). Leave empty and set DLE_ALLOW_TENANT_SELF_SERVICE=true for a single-organisation
# deployment. With neither set the tenant routes deny every caller (deliberate).
DLE_INSTANCE_TENANT_ID=
DLE_ALLOW_TENANT_SELF_SERVICE=false

# OIDC for the admin console and human users (Dle:Identity:Oidc). Empty = API keys only.
DLE_OIDC_AUTHORITY=
DLE_OIDC_CLIENT_ID=
DLE_OIDC_AUDIENCE=

# Analytics store: postgres (default) or clickhouse (needs ConnectionStrings__ClickHouse).
DLE_ANALYTICS_PROVIDER=postgres


# -----------------------------------------------------------------------------
# Privacy defaults (Dle:Privacy) — applied by both services
# -----------------------------------------------------------------------------

# Tenant default consent mode: off | aggregate_only | full
DLE_CONSENT_MODE=aggregate_only
# Deployment ceiling on what may be derived from a client address: none | hash_only | prefix | full
DLE_IP_STORAGE=hash_only


# -----------------------------------------------------------------------------
# Telemetry
# -----------------------------------------------------------------------------

# OTLP endpoint for traces/metrics, e.g. http://otel-collector:4317. Empty disables the exporter.
# Note: an exporter target is an outbound call from the edge; keep it on your own network (NFR-14).
DLE_OTLP_ENDPOINT=


# -----------------------------------------------------------------------------
# Resource limits (NFR-10: the whole stack fits 2 vCPU / 4 GB RAM / 20 GB disk)
# -----------------------------------------------------------------------------
# CPU limits are ceilings and deliberately add up to more than 2 vCPU so that idle capacity can be
# borrowed. Memory limits add up to ~3.2 GB, leaving the rest to the kernel and page cache.

DLE_EDGE_CPUS=0.75
DLE_EDGE_MEMORY=384M
DLE_CONTROL_CPUS=0.5
DLE_CONTROL_MEMORY=512M
DLE_POSTGRES_CPUS=1.0
DLE_POSTGRES_MEMORY=1536M
DLE_VALKEY_CPUS=0.25
DLE_VALKEY_MEMORY=320M
DLE_CADDY_CPUS=0.5
DLE_CADDY_MEMORY=128M
