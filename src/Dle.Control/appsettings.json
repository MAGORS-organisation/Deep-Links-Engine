{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=dle;Username=dle;Password=dle",
    "Valkey": "",
    "ClickHouse": ""
  },

  "Dle": {
    "Control": {
      "PublicScheme": "https",
      "QrPathSuffix": "/qr",
      "DefaultPageSize": 50,
      "MaxPageSize": 200,
      "BulkMaxRows": 10000,
      "AssociationPropagationDays": 7,
      "MaxLinkVersions": 50,
      "NodeId": 0,
      "InstanceTenantId": null,
      "AllowTenantSelfService": false,
      "ServeAdminSpa": true,
      "SpaIndexFile": "index.html"
    },

    "Persistence": {
      "CommandTimeoutSeconds": 30,
      "MaxRetryCount": 3,
      "MaxRetryDelaySeconds": 5,
      "SlugBlockSize": 1000,
      "SlugSequenceName": "default",
      "IdempotencyRetentionHours": 24,
      "WebhookLeaseSeconds": 60
    },

    "Identity": {
      "CredentialCacheSeconds": 60,
      "EnableSdkKeys": true,
      "SdkKeyName": "dlk",
      "Oidc": {
        "Authority": "",
        "ClientId": "",
        "Audience": "",
        "TenantClaim": "dle_tenant",
        "RoleClaim": "dle_role",
        "RequireHttpsMetadata": true
      }
    },

    "Crypto": {
      "SigningAlgorithm": "Ed25519",
      "HybridPqEnabled": false,
      "KeyRotationDays": 90,
      "SlugFeistelRounds": 4,
      "ApiKeyPrefix": "dle",
      "IpSaltRotationHours": 24
    },

    "Attribution": {
      "Strategies": [ "install_referrer", "login", "claim_code" ],
      "Probabilistic": {
        "Enabled": false,
        "WindowMinutes": 60,
        "MinConfidence": 0.55,
        "RequireConsent": true
      },
      "ClaimCode": {
        "Enabled": true,
        "TtlMinutes": 15
      }
    },

    "Privacy": {
      "ConsentMode": "aggregate_only",
      "IpStorage": "hash_only",
      "IpSaltRotationHours": 24,
      "Retention": {
        "RawDays": 30,
        "AggregatedDays": 730
      }
    },

    "Analytics": {
      "Provider": "postgres"
    },

    "Abuse": {
      "UrlHausEnabled": false,
      "BlocklistPath": "",
      "RecheckIntervalHours": 24,
      "ReportsPerHourPerIp": 5
    },

    "Webhooks": {
      "MaxAttempts": 8,
      "BaseDelaySeconds": 5,
      "TimeoutSeconds": 10
    },

    "RateLimits": {
      "LinkCreatePerMinute": 60,
      "NewTenantLinkCreatePerMinute": 10,
      "NewTenantDays": 7,
      "BulkConcurrentBatches": 2,
      "BulkQueuedBatches": 0,
      "AuthAttemptsPerMinute": 10,
      "AuthAttemptBurst": 10,
      "ReadPerMinute": 600,
      "WritePerMinute": 120,
      "RetryAfterSeconds": 60
    },

    "Telemetry": {
      "ServiceName": "dle-control",
      "OtlpEndpoint": "",
      "ConsoleLogging": true,
      "TraceSampleRatio": 1.0,
      "TraceRequests": true
    }
  }
}
