{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=dle;Username=dle;Password=dle",
    "Valkey": "localhost:6379"
  },

  "Dle": {
    "Control": {
      "PublicScheme": "http",
      "AllowTenantSelfService": true
    },

    "Identity": {
      "Oidc": {
        "RequireHttpsMetadata": false
      }
    },

    "Crypto": {
      "MasterSecret": "development-only-master-secret-change-me-000000",

      // The edge mints click identifiers, claim codes and IP hashes under keys derived from ITS
      // secret (src/Dle.Edge/appsettings.Development.json). The control plane verifies them, so it
      // needs that same secret for exactly these three purposes, as deploy/docker-compose.yml does
      // with DLE_EDGE_SECRET. Without them every click identifier fails its MAC here and deferred
      // deep linking cannot work under `dotnet run`.
      "ClickIdSecret": "dle-development-master-secret-do-not-use-in-production",
      "IpHashSecret": "dle-development-master-secret-do-not-use-in-production",
      "ClaimCodeSecret": "dle-development-master-secret-do-not-use-in-production"
    },

    "Telemetry": {
      "TraceSampleRatio": 1.0
    }
  }
}
