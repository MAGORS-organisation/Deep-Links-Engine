{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=dle;Username=dle;Password=dle",
    "Valkey": "localhost:6379"
  },

  "Dle": {
    "Control": {
      "PublicScheme": "http",
      "AllowTenantSelfService": true
    },

    "Identity": {
      "Oidc": {
        "RequireHttpsMetadata": false
      }
    },

    "Crypto": {
      "MasterSecret": "development-only-master-secret-change-me-000000"
    },

    "Telemetry": {
      "TraceSampleRatio": 1.0
    }
  }
}
