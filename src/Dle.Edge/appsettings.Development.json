{
  // Local development only. Everything here is either a value that would be wrong in production or a
  // secret that is safe precisely because it is published: the development master secret below is in
  // the repository, so anything derived from it must be assumed known to everyone.

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      // SHARED-KERNEL section 17.5 forbids the full query string at Information or below, and this is
      // the logger that writes the whole request line. Warning here keeps the rule true on a
      // developer's machine as well as in production, where the parent category is already Warning.
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Dle": "Debug"
    }
  },

  "ConnectionStrings": {
    // Matches the compose file in deploy/. Nothing here connects at start-up: the pool is lazy and
    // section D.6 requires the edge to start and serve from cache with the database unreachable.
    "Postgres": "Host=127.0.0.1;Port=5432;Database=dle;Username=dle;Password=dle",
    "PostgresRead": "",
    // Left empty on purpose so a developer exercises the L1-only profile (section B.8 profile A)
    // rather than silently depending on Valkey being up.
    "Valkey": ""
  },

  "Dle": {
    "Edge": {
      "Interstitial": {
        // Long enough to see the page and press the stop control while developing it.
        "AutoRedirectMs": 3000,
        "AppealEmail": "abuse@localhost",
        "DefaultLanguage": "en"
      },

      "BotDetection": {
        // A development machine has no reverse DNS for the crawlers, and every request comes from
        // the loopback address, so confirmation could only ever fail. Off means a user agent that
        // claims to be Googlebot is served the Open Graph page, which is what makes the preview
        // testable locally. Never off anywhere a real client can reach.
        "ReverseDnsVerify": false,
        "CacheTtlMinutes": 5
      },

      "GeoIp": {
        // No GeoLite2 file locally. Country stays null and geo-conditioned rules fall through to the
        // default rule, which is the documented degraded behaviour (section D.6) and is worth
        // developing against.
        "Provider": "None"
      },

      "Cache": {
        // Short enough that a change made in the control plane shows up on the next refresh instead
        // of on the next coffee break.
        "L1Seconds": 5,
        "L2Minutes": 1,
        "NegativeSeconds": 5
      },

      "Security": {
        // The headers stay on - they are part of what is being developed (S-04, T-11) - but HSTS is
        // not pinned, because a browser that pins localhost breaks every other project on the machine.
        "Enabled": true,
        "HstsMaxAgeSeconds": 0,
        "HstsIncludeSubDomains": false
      },

      "Network": {
        "UseForwardedHeaders": false
      }
    },

    "Privacy": {
      "ConsentMode": "full",
      "IpStorage": "prefix"
    },

    "Crypto": {
      // Development only, and public by virtue of being committed. Production supplies its own
      // through Dle__Crypto__MasterSecret and the process refuses to start without one.
      "MasterSecret": "dle-development-master-secret-do-not-use-in-production"
    },

    "RateLimits": {
      "Edge": {
        // The 404 budget is left at the production value on purpose: a limit that is only exercised
        // in production is a limit nobody has tested. The successful-resolve window is widened so
        // that a page reload loop while working on the interstitial does not hit it.
        "Resolve": {
          "PermitsPerWindow": 6000
        }
      }
    },

    "Telemetry": {
      "TraceSampleRatio": 1.0
    }
  }
}
