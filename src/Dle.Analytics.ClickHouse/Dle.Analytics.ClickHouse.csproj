<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Opt-in IClickAnalyticsStore implementation over ClickHouse, selected with
    Dle:Analytics:Provider = clickhouse. ADR-006.
  -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Dle.Analytics.ClickHouse</PackageId>
    <Description>Deep Link Engine analytics store backed by ClickHouse. Optional provider for deployments that outgrow partitioned PostgreSQL.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dle.Domain\Dle.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickHouse.Client" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
